/* Default tema: koyu lacivert tonlar, modern kontroller */
/* Diyalog/pencere kenarlığı — çocuk widget'lara opak arka plan basma */
QDialog {
  background: #0b1220;
  color: #e6edf3;
}
QWidget {
  color: #e6edf3;
  background: transparent;
}
#HistoryWindow {
  background: #0b1220;
}
QMenu {
  background: #0f172a;
  color: #e6edf3;
}
QGroupBox { border: none; margin-top: 8px; }
QTabWidget::pane { border: none; background: transparent; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* Kart widget'ları için çerçeve kaldır */
#ItemCard {
    border: none;
}

QScrollArea {
  border: none;
  background: transparent;
}
QScrollArea > QWidget > QWidget {
  background: transparent;
}

/* Giriş ve butonlar */
QLineEdit, QComboBox, QSpinBox {
  background: #0f172a;
  color: #e6edf3;
  border: 1px solid rgba(31, 41, 55, 0.7);
  border-radius: 8px;
  padding: 6px 10px;
}
QComboBox {
  padding: 6px 30px 6px 10px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #7aa2ff; }

QComboBox::drop-down {
  width: 0;
  border: none;
}
QComboBox::down-arrow {
  width: 0;
  height: 0;
}

QComboBox QAbstractItemView {
  background: #0f172a;
  color: #e6edf3;
  border: 1px solid #1f2937;
  selection-background-color: #15233b;
  selection-color: #ffffff;
  outline: none;
  border-radius: 8px;
  padding: 4px;
}

QPushButton {
  background: #0f172a;
  color: #e6edf3;
  border: none;
  border-radius: 8px;
  padding: 6px 12px;
}
QPushButton:hover { background: #15233b; }
QPushButton:pressed { background: #0b1626; }

QPushButton[class~="accent"] {
    background: #1d4ed8;
    border: none;
    color: #f8fafc;
    font-weight: 600;
}
QPushButton[class~="accent"]:hover {
    background: #2563eb;
}
QPushButton[class~="accent"]:pressed {
    background: #1e3a8a;
}

/* Sekmeler */
QTabBar::tab {
  background: transparent;
  padding: 8px 12px;
  margin-right: 2px;
  color: #cbd5e1;
}
QTabBar::tab:selected { color: #e6edf3; border-bottom: 2px solid #7aa2ff; }

/* Menü */
QMenu { background: #0f172a; color: #e6edf3; border: 1px solid #1f2937; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 6px 12px; border-radius: 6px; }
QMenu::item:selected { background: #15233b; }

/* Scrollbar – oval ve modern */
QScrollBar:vertical { background: transparent; width: 12px; margin: 4px 2px 4px 0; }
QScrollBar::handle:vertical {
  background: #35507a;
  border-radius: 6px;
  min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: #40649b; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; background: transparent; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal { background: transparent; height: 12px; margin: 0 4px 2px 4px; }
QScrollBar::handle:horizontal {
  background: #35507a;
  border-radius: 6px;
  min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background: #40649b; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; border: none; background: transparent; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }


#HoverHighlight { background: rgba(0,0,0,0.10); border-radius: 12px; }
#HoverToolbar   { background: rgba(0,0,0,0.22); border-top-left-radius: 12px; border-top-right-radius: 12px; }

/* === HATIRLATMA KARTI - KOMPAKT MODERN TASARIM === */
#ReminderCard {
    background: rgba(15, 23, 42, 0.72);
    border: 1px solid rgba(96, 165, 250, 0.28);
    border-radius: 16px;
    min-height: 72px;
}

#ReminderCard:hover {
    background: rgba(22, 34, 56, 0.82);
    border: 1px solid rgba(96, 165, 250, 0.42);
}

#ReminderTitle {
    font-size: 11pt;
    font-weight: 600;
    color: #f8fafc;
    background: transparent;
}

#ReminderDescription {
    font-size: 9pt;
    color: #cbd5e1;
    background: transparent;
}

#ReminderTime {
    font-size: 9pt;
    color: #93a8c1;
    font-weight: 500;
    background: transparent;
}

#ReminderRepeat {
    font-size: 8.5pt;
    color: #60a5fa;
    font-weight: 500;
    background: transparent;
}

#ReminderEditBtn,
#ReminderDeleteBtn {
    min-width: 32px;
    min-height: 32px;
    padding: 0;
    border-radius: 8px;
    font-size: 11pt;
}

#ReminderEditBtn {
    background: rgba(59, 130, 246, 0.18);
    border: 1px solid rgba(59, 130, 246, 0.36);
    color: #bfdbfe;
}

#ReminderEditBtn:hover {
    background: rgba(59, 130, 246, 0.26);
    border: 1px solid rgba(59, 130, 246, 0.48);
    color: #e0f2fe;
}

#ReminderDeleteBtn {
    background: rgba(239, 68, 68, 0.18);
    border: 1px solid rgba(239, 68, 68, 0.36);
    color: #fca5a5;
}

#ReminderDeleteBtn:hover {
    background: rgba(239, 68, 68, 0.26);
    border: 1px solid rgba(239, 68, 68, 0.48);
    color: #fecaca;
}

/* === HATIRLATMA BİLDİRİM POPUP === */
#ReminderNotificationContent {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1e293b,
                                stop:1 #0f172a);
    border: 2px solid rgba(96, 165, 250, 0.4);
    border-radius: 16px;
}

#ReminderNotificationTitle {
    color: #f1f5f9;
}

#ReminderNotificationDesc {
    color: #cbd5e1;
}

#ReminderNotificationSeparator {
    background: rgba(148, 163, 184, 0.25);
    border: none;
}

#ReminderSnoozeBtn {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}

#ReminderSnoozeBtn:hover {
    background: rgba(251, 191, 36, 0.25);
    border: 1px solid rgba(251, 191, 36, 0.5);
}

#ReminderSnoozeBtn:pressed {
    background: rgba(251, 191, 36, 0.35);
}

#ReminderDismissBtn {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}

#ReminderDismissBtn:hover {
    background: rgba(239, 68, 68, 0.25);
    border: 1px solid rgba(239, 68, 68, 0.5);
}

#ReminderDismissBtn:pressed {
    background: rgba(239, 68, 68, 0.35);
}

/* Tooltip */
QToolTip {
    background: #0f172a;
    color: #e6edf3;
    border: 1px solid #1f2937;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* === SIDEBAR (default tema override) === */
#AppSidebar {
    background: #0a1220;
    border: none;
    border-right: 1px solid rgba(31, 41, 55, 0.55);
}
#SidebarAppTitle { color: #e6edf3; background: transparent; border: none; }
#SidebarNavButton, #SidebarSettingsBtn, #SidebarQuickBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
}
#SidebarNavButton:hover, #SidebarSettingsBtn:hover, #SidebarQuickBtn:hover {
    background: #15233b;
}
#SidebarNavButton:checked {
    background: #1d4ed8;
}
#SidebarNavText { color: #e6edf3; background: transparent; border: none; }
#SidebarCountBadge {
    background: rgba(21, 35, 59, 0.9);
    color: #93c5fd;
    border: none;
    border-radius: 8px;
    padding: 2px 7px;
    font-size: 10px;
}
#SidebarNavButton:checked #SidebarCountBadge {
    background: rgba(255,255,255,0.16);
    color: #fff;
}
#SidebarSectionHeader { color: #64748b; background: transparent; border: none; }
#SidebarShortcut {
    color: #64748b;
    background: rgba(15, 23, 42, 0.8);
    border: none;
    border-radius: 4px;
    padding: 1px 6px;
}
#SidebarVersion { color: #64748b; background: transparent; border: none; }

/* === ITEM CARD — çerçevesiz soft yüzey === */
#ItemCard {
    background: #111827;
    border: none;
    border-radius: 14px;
}
#ItemCard:hover {
    background: #15233b;
    border: none;
}
#ItemCard QLabel,
#ItemCard QToolButton,
#ItemCard QFrame {
    background: transparent;
    border: none;
}
#ItemPreview, #ItemTitle, #MetaLabel {
    background: transparent;
    border: none;
}
#MetaLabel { color: #94a3b8; }
#ItemTypeBadge {
    background: rgba(30, 41, 59, 0.95);
    border: none;
    border-radius: 7px;
}
#SkeletonCard {
    background: #111827;
    border: none;
    border-radius: 14px;
}
#SearchSidePanel {
    background: #0a1220;
    border: none;
    border-left: 1px solid rgba(31, 41, 55, 0.55);
}
#PaginationBar {
    background: transparent;
    border: none;
}
#PaginationBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 8px;
}
#PaginationBar QPushButton:hover {
    background: #15233b;
}
#FilterToggleBtn {
    background: #111827;
    border: none;
    border-radius: 8px;
}
#FilterToggleBtn:hover {
    background: #15233b;
}
#SearchBox {
    background: #0f172a;
    border: 1px solid rgba(51, 65, 85, 0.7);
    border-radius: 10px;
}
#SearchShortcutBadge {
    background: rgba(30, 41, 59, 0.95);
    color: #94a3b8;
    border: none;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
#FilterChipBar { background: transparent; border: none; }
#FilterChip {
    background: #111827;
    color: #e2e8f0;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
}
#FilterChip:hover { background: #15233b; }
#FilterChip:checked { background: #1d4ed8; color: #fff; }
#ItemCard[viewMode="list"] {
    /* liste satırı */
}
#ViewModeBtn {
    background: #111827;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    color: #cbd5e1;
}
#ViewModeBtn:checked { background: #1d4ed8; color: #fff; }
#FilterChip {
    padding-left: 10px;
    padding-right: 12px;
}
#PaginationBar QPushButton {
    padding-left: 10px;
    padding-right: 10px;
}
